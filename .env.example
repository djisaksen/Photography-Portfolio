# Required to upload, edit, or delete photographs.
# Use a long password before anyone else can reach this server.
ADMIN_PASSWORD=change-me

# Optional. Signs the studio session cookie.
# When unset, the cookie is signed with ADMIN_PASSWORD.
SESSION_SECRET=

# local (default) stores files on disk. blob uses Vercel Blob.
# s3 and cloud are reserved and not implemented.
STORAGE_DRIVER=local

# Optional absolute directory for image files and library.json.
# Used only when STORAGE_DRIVER=local. Defaults to ./storage.
STORAGE_DIR=

# Required when STORAGE_DRIVER=blob.
# Read-write token from the Vercel Blob store connected to this project.
BLOB_READ_WRITE_TOKEN=
